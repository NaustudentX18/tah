<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- M1: Ollama LAN is often http://192.168.x.x. Not a license to ship secrets. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
